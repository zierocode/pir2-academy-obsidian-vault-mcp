{
  "name": "pir-acdm-obsidian-vault",
  "version": "0.3.2",
  "description": "MCP แบบ local สำหรับอ่านและเขียน Obsidian Vault อย่างปลอดภัย โดย PiR-ACDM",
  "license": "MIT",
  "type": "module",
  "main": "./server/index.js",
  "exports": "./server/index.js",
  "files": [
    "server",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:plugin-runtime": "node scripts/build-plugin-runtime.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test",
    "smoke": "node scripts/smoke.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "bundle": "node scripts/pack.mjs",
    "bundle:verify": "node scripts/verify-bundle.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "write-file-atomic": "5.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@eslint/js": "10.0.1",
    "@types/node": "22.18.6",
    "@types/write-file-atomic": "4.0.3",
    "esbuild": "0.28.2",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
